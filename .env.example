# Variable de build (Vite la incrusta en el bundle al compilar, no es una
# variable de runtime como en nexora-api). Esta es una SPA: las peticiones a
# la API salen del NAVEGADOR del usuario, no del contenedor — por eso debe
# ser una URL alcanzable desde fuera de Docker.
#
# En local, nexora-api publica el puerto 3005 al host. En el VPS, cambia
# esto por la URL pública real de la API.
VITE_API_BASE_URL=http://localhost:3005/api/v1
